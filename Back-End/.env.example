# Banco de dados
DATABASE_URL=postgresql://usuario:senha@localhost:5432/rodabem

# Autenticação JWT
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=7d

# Servidor
PORT=3000

# Criptografia de CPF (mínimo 32 caracteres, nunca reutilize entre ambientes)
CRYPTO_SECRET=troque_por_uma_chave_de_32_chars_minimo

# API de rotas (OpenRouteService)
ORS_API_KEY=troque_pela_sua_chave_ors

# E-mail (recuperação de senha)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@exemplo.com
SMTP_PASS=troque_pela_senha_smtp

# URL pública da aplicação
APP_URL=http://localhost:3000
