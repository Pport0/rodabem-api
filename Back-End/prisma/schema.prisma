// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id Int @id @default(autoincrement())

  nome      String
  email     String @unique
  senhaHash String

  cpfEncrypted String
  cpfHash      String @unique

  telefone  String? @unique
  avatarUrl String?

  status Boolean @default(true)

  caminhao Caminhao?

  tokenVersion  Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documento Documento[]
  abastecimentos Abastecimento[]
  simulacoes SimulacaoFrete[]
  passwordResetTokens PasswordResetToken[]

  @@map("usuarios")
}

model TokenBlackList {
  id        Int      @id @default(autoincrement())
  token     String
  createdAt DateTime @default(now())
}

model Caminhao {
  id Int @id @default(autoincrement())

  placa   String
  modelo  String
  renavam String

  crv           String?
  marca         String?
  especieTipo   String?
  chassi        String?
  cor           String?
  anoFabricacao Int?
  numeroEixos   Int? 

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documento Documento[]
  abastecimentos Abastecimento[]
  simulacoes     SimulacaoFrete[]
}

model Documento {
  id Int @id @default(autoincrement())

  nome   String
  numero String

  dataEmissao    DateTime
  dataVencimento DateTime

  observacao String?

  arquivoUrl String?
  publicId   String? 

  userId Int
  user   User @relation(fields: [userId], references: [id])

  caminhaoId Int?
  caminhao   Caminhao? @relation(fields: [caminhaoId], references: [id])

  createdAt DateTime @default(now())

   @@index([userId])
  @@index([caminhaoId])
}


enum TipoCombustivel {
  DIESEL_S10
  DIESEL_S500
  ARLA_32
}

model Abastecimento {
  id Int @id @default(autoincrement())

  precoPorLitro Float
  totalLitros   Float
  valorTotal    Float

  quilometragem Int

  tipoCombustivel TipoCombustivel

  dataAbastecimento DateTime @default(now())

  latitude         Float?
  longitude        Float?
  localDescricao   String?
  postoIdentificado String?

  imagemUrl  String?
  observacao String?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  caminhaoId Int
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([caminhaoId])

  @@map("abastecimentos")
}

enum TipoCarga {
  GERAL
  GRANEL_SOLIDO
  GRANEL_LIQUIDO
  FRIGORIFICADA
  CONTEINER
  GRANEL_PRESSURIZADO  
  NEOGRANEL  
  PERIGOSA_GERAL
  PERIGOSA_CONTEINERIZADA
  PERIGOSA_FRIGORIFICADA
  PERIGOSA_GRANEL_LIQUIDO
  PERIGOSA_GRANEL_SOLIDO
}

model TabelaAntt {
  id          Int        @id @default(autoincrement())
  versaoId    Int
  versao      VersaoAntt @relation(fields: [versaoId], references: [id])

  numeroEixos    Int
  tipoCarga      TipoCarga
  distanciaMin   Int
  distanciaMax   Int
  valorPorKm     Float
  cc             Float     @default(0)
  altoDesempenho Boolean   @default(false)

  composicaoVeicular ComposicaoVeicular @default(COM_CARRETA)

  @@index([versaoId])
  @@map("tabela_antt")
}

model SimulacaoFrete {
  id        Int @id @default(autoincrement())

  origem    String
  destino   String

  distanciaKm      Float
  pedagiosEstimados Float

  consumoMedioKmL  Float
  precoCombustivel Float
  litrosNecessarios Float
  custoCombustivel  Float

  tipoCarga        TipoCarga
  retornoVazio     Boolean @default(false)
  altoDesempenho   Boolean @default(false)

  valorMinimoAntt  Float
  valorLiquidoEstimado Float

  percentualLucroDesejado Float?
  valorSugerido           Float?

  userId     Int
  user       User     @relation(fields: [userId], references: [id])

  caminhaoId Int
  caminhao   Caminhao @relation(fields: [caminhaoId], references: [id])

  createdAt  DateTime @default(now())

   versaoAnttId Int
  versaoAntt   VersaoAntt @relation(fields: [versaoAnttId], references: [id])

  @@index([userId])
  @@index([caminhaoId])
  @@index([versaoAnttId])

  @@map("simulacoes_frete")
}

model VersaoAntt {
  id           Int              @id @default(autoincrement())
  resolucao    String           @unique
  vigenteDesde DateTime
  vigenteAte   DateTime?
  criadoEm     DateTime         @default(now())

  tabela     TabelaAntt[]
  simulacoes SimulacaoFrete[]

  @@map("versoes_antt")
}

enum ComposicaoVeicular {
  COM_CARRETA
  SEM_CARRETA
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}